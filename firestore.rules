rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn()
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true
        && !request.auth.token.email.matches('.*@dominio-temporal\\.com');
    }

    function isAdmin() {
      return verified()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function activePublishedListing(data) {
      return data.status == 'published'
        && data.expiresAt is int
        && data.expiresAt > request.time.toMillis();
    }

    function validDisplayName(value) {
      return value is string
        && value.size() >= 2
        && value.size() <= 60
        && !value.matches('.*[<>].*');
    }

    function validGooglePhoto(value) {
      return value is string
        && value.size() <= 2048
        && value.matches('^https://lh3\\.googleusercontent\\.com/.*$');
    }

    function validListingText(data) {
      return data.title is string
        && data.title.size() >= 8
        && data.title.size() <= 80
        && data.description is string
        && data.description.size() >= 30
        && data.description.size() <= 1500
        && !data.title.matches('.*[<>].*')
        && !data.description.matches('.*[<>].*')
        && data.colonia is string
        && data.colonia.size() >= 2
        && data.colonia.size() <= 80
        && !data.colonia.matches('.*[<>].*');
    }

    // Acepta Timestamp de servidor y, durante la transición, milisegundos antiguos.
    function validConsentTime(value) {
      return (value is timestamp && value == request.time)
        || (value is int && value <= request.time.toMillis());
    }

    // Reglas de la casa: cada campo es opcional, pero si viene debe tener el tipo correcto.
    function validHouseRules(d) {
      return (!('maxGuests' in d)
          || (d.maxGuests is int && d.maxGuests >= 1 && d.maxGuests <= 50))
        && (!('childrenAllowed' in d) || d.childrenAllowed is bool)
        && (!('petsAllowed' in d) || d.petsAllowed is bool)
        && (!('smokingAllowed' in d) || d.smokingAllowed is bool)
        && (!('alcoholConsumptionAllowed' in d) || d.alcoholConsumptionAllowed is bool)
        && (!('alcoholSalesAllowed' in d) || d.alcoholSalesAllowed is bool)
        && (!('commercialActivityAllowed' in d) || d.commercialActivityAllowed is bool)
        && (!('commercialActivityNotes' in d) || (d.commercialActivityNotes is string && d.commercialActivityNotes.size() <= 240 && !d.commercialActivityNotes.matches('.*[<>].*')))
        && (!('shortStayUse' in d) || (d.operation == 'hospedaje' && d.category in ['casa', 'departamento', 'cuarto'] && d.shortStayUse in ['vacation', 'events', 'both', 'other']))
        && (!('shortStayNotes' in d) || (d.shortStayNotes is string && d.shortStayNotes.size() <= 240 && !d.shortStayNotes.matches('.*[<>].*')));
    }

    function validListingExtras(d) {
      return (!('priceUnit' in d) || d.priceUnit in ['mes', 'dia', 'noche', 'total', 'estancia'])
        && (d.operation != 'renta' || !('priceUnit' in d) || d.priceUnit in ['mes', 'total'])
        && (d.operation != 'venta' || !('priceUnit' in d) || d.priceUnit == 'total')
        && (d.operation != 'hospedaje' || !('priceUnit' in d) || d.priceUnit in ['dia', 'noche', 'mes', 'estancia'])
        && (!('securityDepositMonths' in d) || (d.securityDepositMonths is int && d.securityDepositMonths >= 0 && d.securityDepositMonths <= 12))
        && (!('minimumLeaseMonths' in d) || (d.minimumLeaseMonths is int && d.minimumLeaseMonths >= 1 && d.minimumLeaseMonths <= 120))
        && (!('guarantorRequired' in d) || d.guarantorRequired is bool)
        && (!('proofIncomeRequired' in d) || d.proofIncomeRequired is bool)
        && (!('rentalRequirementsNotes' in d) || (d.rentalRequirementsNotes is string && d.rentalRequirementsNotes.size() <= 300 && !d.rentalRequirementsNotes.matches('.*[<>].*')))
        && (!('waterBilling' in d) || d.waterBilling in ['included', 'extra', 'unknown'])
        && (!('electricityBilling' in d) || d.electricityBilling in ['included', 'extra', 'unknown'])
        && (!('internetBilling' in d) || d.internetBilling in ['included', 'extra', 'unknown'])
        && (!('waterMonthlyCost' in d) || (d.waterMonthlyCost is number && d.waterMonthlyCost >= 0 && d.waterMonthlyCost <= 100000))
        && (!('waterBilling' in d) || d.waterBilling != 'extra' || ('waterMonthlyCost' in d))
        && (!('electricityMonthlyCost' in d) || (d.electricityMonthlyCost is number && d.electricityMonthlyCost >= 0 && d.electricityMonthlyCost <= 100000))
        && (!('electricityBilling' in d) || d.electricityBilling != 'extra' || ('electricityMonthlyCost' in d))
        && (!('internetMonthlyCost' in d) || (d.internetMonthlyCost is number && d.internetMonthlyCost >= 0 && d.internetMonthlyCost <= 100000))
        && (!('internetBilling' in d) || d.internetBilling != 'extra' || ('internetMonthlyCost' in d))
        && (!('stepFreeAccess' in d) || d.stepFreeAccess is bool)
        && (!('rampAccess' in d) || d.rampAccess is bool)
        && (!('accessibleBathroom' in d) || d.accessibleBathroom is bool)
        && (!('elevatorAccess' in d) || d.elevatorAccess is bool)
        && (!('visitAvailability' in d) || (d.visitAvailability is string && d.visitAvailability.size() <= 160 && !d.visitAvailability.matches('.*[<>].*')))
        && (!('openHouseStartAt' in d) || (d.openHouseStartAt is int && d.openHouseStartAt > 0))
        && (!('openHouseEndAt' in d) || (d.openHouseEndAt is int && d.openHouseEndAt > 0))
        && (('openHouseStartAt' in d) == ('openHouseEndAt' in d))
        && (!('openHouseStartAt' in d) || !('openHouseEndAt' in d) || d.openHouseEndAt > d.openHouseStartAt)
        && (!('openHouseCapacity' in d) || (d.openHouseCapacity is int && d.openHouseCapacity >= 1 && d.openHouseCapacity <= 500))
        && (!('openHouseNotes' in d) || (d.openHouseNotes is string && d.openHouseNotes.size() <= 240 && !d.openHouseNotes.matches('.*[<>].*')))
        && (!('roommateWanted' in d) || d.roommateWanted is bool)
        && (!('roommatePreferences' in d) || (d.roommatePreferences is string && d.roommatePreferences.size() <= 300 && !d.roommatePreferences.matches('.*[<>].*')))
        && (!('roommatesWantedCount' in d) || (d.roommatesWantedCount is int && d.roommatesWantedCount >= 1 && d.roommatesWantedCount <= 10))
        && (!('currentOccupants' in d) || (d.currentOccupants is int && d.currentOccupants >= 1 && d.currentOccupants <= 30))
        && (!('roommatePrivateRoom' in d) || d.roommatePrivateRoom is bool)
        && (!('roommateFurnished' in d) || d.roommateFurnished is bool)
        && (!('roommateSharedBathroom' in d) || d.roommateSharedBathroom is bool)
        && (!('roommateSharedKitchen' in d) || d.roommateSharedKitchen is bool)
        && (!('roommateAuthorizationConfirmed' in d) || d.roommateAuthorizationConfirmed is bool)
        && (!('roommateWanted' in d) || d.roommateWanted != true || (d.category in ['casa', 'departamento', 'cuarto']
          && d.operation == 'renta'
          && (!('roommatesWantedCount' in d) || (d.lat == 20.4833 && d.lng == -99.2167))))
        && (!('roommatesWantedCount' in d) || (d.roommateWanted == true
          && 'currentOccupants' in d
          && 'roommatePrivateRoom' in d
          && 'roommateFurnished' in d
          && 'roommateSharedBathroom' in d
          && 'roommateSharedKitchen' in d
          && 'roommateAuthorizationConfirmed' in d
          && d.roommateAuthorizationConfirmed == true));
    }

    // Entorno declarado por la persona que publica. Opcional para mantener
    // compatibilidad con anuncios existentes; valida el tipo, tamaño y enums.
    function validNearbyInformation(d) {
      return (!('nearbyPlaces' in d)
          || (d.nearbyPlaces is string
            && d.nearbyPlaces.size() <= 240
            && !d.nearbyPlaces.matches('.*[<>].*')))
        && (!('nearbyServices' in d)
          || (d.nearbyServices is list
            && d.nearbyServices.size() <= 10
            && d.nearbyServices.hasOnly([
              'hospital-clinic', 'schools', 'market', 'public-transport',
              'shops', 'parks', 'university', 'downtown', 'balnearios', 'other'
            ])))
        && (!('nearbyServicesOther' in d)
          || (d.nearbyServicesOther is string
            && d.nearbyServicesOther.size() <= 120
            && !d.nearbyServicesOther.matches('.*[<>].*')))
        && (!('safetyLevel' in d)
          || d.safetyLevel in ['quiet', 'mixed', 'caution', 'unknown', 'other'])
        && (!('safetyDetails' in d)
          || (d.safetyDetails is string
            && d.safetyDetails.size() <= 240
            && !d.safetyDetails.matches('.*[<>].*')))
        && (!('waterIssueLevel' in d)
          || d.waterIssueLevel in ['none', 'occasional', 'frequent', 'severe', 'unknown', 'other'])
        && (!('waterIssueDetails' in d)
          || (d.waterIssueDetails is string
            && d.waterIssueDetails.size() <= 240
            && !d.waterIssueDetails.matches('.*[<>].*')))
        && (!('transportAvailability' in d)
          || d.transportAvailability in ['nearby', 'limited', 'none', 'unknown'])
        && (!('transportDestinations' in d)
          || (d.transportDestinations is string
            && d.transportDestinations.size() <= 200
            && !d.transportDestinations.matches('.*[<>].*')));
    }

    function validCloudinaryPhotoAt(d, index) {
      return d.photos.size() <= index
        || (d.photos[index] is string
          && d.photos[index].matches('^https://res\\.cloudinary\\.com/ckaf3htn/image/upload/.*$'));
    }

    function validCloudinaryPhotos(d) {
      return d.photos is list
        && d.photos.size() >= 1
        && d.photos.size() <= 10
        && validCloudinaryPhotoAt(d, 0)
        && validCloudinaryPhotoAt(d, 1)
        && validCloudinaryPhotoAt(d, 2)
        && validCloudinaryPhotoAt(d, 3)
        && validCloudinaryPhotoAt(d, 4)
        && validCloudinaryPhotoAt(d, 5)
        && validCloudinaryPhotoAt(d, 6)
        && validCloudinaryPhotoAt(d, 7)
        && validCloudinaryPhotoAt(d, 8)
        && validCloudinaryPhotoAt(d, 9);
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.isBanned == false
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.email == request.auth.token.email
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > 0
        && (!('phone' in request.resource.data)
          || request.resource.data.phone.matches('^[0-9]{10}$'))
        && (!('photoURL' in request.resource.data)
          || validGooglePhoto(request.resource.data.photoURL))
        && (!request.resource.data.keys().hasAny(['termsAcceptedVersion', 'termsAcceptedAt'])
          || (request.resource.data.termsAcceptedVersion is string
            && request.resource.data.termsAcceptedVersion.size() > 0
            && validConsentTime(request.resource.data.termsAcceptedAt)))
        && (!request.resource.data.keys().hasAny(['adultConfirmedVersion', 'adultConfirmedAt'])
          || (request.resource.data.adultConfirmedVersion == '2026-10-06-v7'
            && validConsentTime(request.resource.data.adultConfirmedAt)))
        && (!request.resource.data.keys().hasAny(['privacyConsentVersion', 'privacyConsentAt'])
          || (request.resource.data.privacyConsentVersion is string
            && request.resource.data.privacyConsentVersion.size() > 0
            && validConsentTime(request.resource.data.privacyConsentAt)))
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'emailVerified', 'displayName', 'role',
          'photoURL', 'phone', 'createdAt', 'isBanned',
          'termsAcceptedVersion', 'termsAcceptedAt',
          'adultConfirmedVersion', 'adultConfirmedAt',
          'privacyConsentVersion', 'privacyConsentAt'
        ]);

      // El usuario puede completar su perfil, pero nunca cambiar su rol.
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'phone', 'emailVerified',
            'termsAcceptedVersion', 'termsAcceptedAt',
            'adultConfirmedVersion', 'adultConfirmedAt',
            'privacyConsentVersion', 'privacyConsentAt',
            'phoneConsentVersion', 'phoneConsentAt'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'termsAcceptedVersion', 'termsAcceptedAt'
          ])
            || (request.resource.data.termsAcceptedVersion is string
              && request.resource.data.termsAcceptedVersion.size() > 0
              && validConsentTime(request.resource.data.termsAcceptedAt)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'privacyConsentVersion', 'privacyConsentAt'
          ])
            || (request.resource.data.privacyConsentVersion is string
              && request.resource.data.privacyConsentVersion.size() > 0
              && validConsentTime(request.resource.data.privacyConsentAt)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'adultConfirmedVersion', 'adultConfirmedAt'
          ])
            || (request.resource.data.adultConfirmedVersion == '2026-10-06-v7'
              && validConsentTime(request.resource.data.adultConfirmedAt)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'phone', 'phoneConsentVersion', 'phoneConsentAt'
          ])
            || (request.resource.data.phoneConsentVersion == '2026-10-06-v11'
              && validConsentTime(request.resource.data.phoneConsentAt)))
          && request.resource.data.role == resource.data.role
          && request.resource.data.isBanned == resource.data.isBanned
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.emailVerified == request.auth.token.email_verified
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
            || validDisplayName(request.resource.data.displayName))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL'])
            || !('photoURL' in request.resource.data)
            || validGooglePhoto(request.resource.data.photoURL))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
            || !('phone' in request.resource.data)
            || request.resource.data.phone.matches('^[0-9]{10}$')));

      allow delete: if isAdmin();

      // Cada usuario administra solo los tokens push de sus propios dispositivos.
      match /pushTokens/{tokenId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if verified()
          && request.auth.uid == userId
            && get(/databases/$(database)/documents/users/$(userId)).data.privacyConsentVersion == '2026-10-06-v11'
          && request.resource.data.keys().hasOnly([
            'token', 'createdAt', 'updatedAt', 'privacyConsentVersion', 'privacyConsentAt'
          ])
          && request.resource.data.keys().hasAll([
            'token', 'createdAt', 'updatedAt', 'privacyConsentVersion', 'privacyConsentAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.privacyConsentVersion == '2026-10-06-v11'
          && request.resource.data.privacyConsentAt == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /publicProfiles/{userId} {
      // No servir perfiles antiguos con campos privados mientras el usuario
      // todavía no haya sincronizado el nuevo formato mínimo.
      allow read: if isAdmin()
        || resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL']);

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && validDisplayName(request.resource.data.displayName)
        && (!('photoURL' in request.resource.data)
          || validGooglePhoto(request.resource.data.photoURL))
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoURL'
        ]);

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'emailVerified', 'createdAt', 'isBanned'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL'])
          && validDisplayName(request.resource.data.displayName)
          && (!('photoURL' in request.resource.data)
            || validGooglePhoto(request.resource.data.photoURL)));

      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      // La lectura pública depende del estado publicado. La vigencia se
      // filtra en la interfaz; las reglas siguen validando vencimientos en
      // operaciones que requieren un anuncio activo.
      allow read: if resource.data.status == 'published'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      allow create: if verified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerEmailVerified == true
        && getAfter(/databases/$(database)/documents/listingPrivateDetails/$(listingId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/listingPrivateDetails/$(listingId)).data.whatsapp is string
        && getAfter(/databases/$(database)/documents/listingPrivateDetails/$(listingId)).data.whatsapp.matches('^[0-9]{10}$')
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.termsAcceptedVersion == '2026-10-06-v7'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adultConfirmedVersion == '2026-10-06-v7'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.privacyConsentVersion == '2026-10-06-v11'
        && request.resource.data.publicationConsentVersion == '2026-09-26'
        && validConsentTime(request.resource.data.publicationConsentAt)
        && request.resource.data.status == 'pending'
        // Los contadores siempre nacen en cero (evita inflar métricas desde la consola).
        && request.resource.data.reportsCount == 0
        && request.resource.data.viewsCount == 0
        && request.resource.data.favoritesCount == 0
        && request.resource.data.whatsappContactsCount == 0
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis()
        && validCloudinaryPhotos(request.resource.data)
        && validListingText(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'ownerId', 'ownerEmailVerified', 'title', 'description',
          'category', 'operation', 'price', 'priceUnit', 'colonia',
          'lat', 'lng', 'bedrooms', 'bathrooms', 'parkingSpots',
          'areaM2', 'amenities', 'status', 'availability',
          'nearbyPlaces', 'nearbyServices', 'nearbyServicesOther',
          'safetyLevel', 'safetyDetails', 'waterIssueLevel', 'waterIssueDetails',
          'transportAvailability', 'transportDestinations',
          'availabilityConfirmedAt', 'expiresAt', 'photos', 'photoPublicIds',
          'showPhone', 'reportsCount', 'viewsCount',
          'publicationConsentVersion', 'publicationConsentAt',
          'establishmentName', 'roomType', 'stayDurationHours',
          'checkInTime', 'checkOutTime', 'reception24h',
          'foodAvailable', 'foodDescription',
          'maxGuests', 'childrenAllowed', 'petsAllowed', 'smokingAllowed',
          'whatsappContactsCount', 'favoritesCount', 'createdAt', 'updatedAt',
          'alcoholConsumptionAllowed', 'alcoholSalesAllowed',
          'commercialActivityAllowed', 'commercialActivityNotes', 'shortStayUse', 'shortStayNotes',
          'securityDepositMonths', 'guarantorRequired', 'proofIncomeRequired',
          'minimumLeaseMonths', 'rentalRequirementsNotes',
          'waterBilling', 'waterMonthlyCost', 'electricityBilling', 'electricityMonthlyCost',
          'internetBilling', 'internetMonthlyCost', 'stepFreeAccess', 'rampAccess',
          'accessibleBathroom', 'elevatorAccess', 'visitAvailability',
          'openHouseStartAt', 'openHouseEndAt', 'openHouseCapacity', 'openHouseNotes',
          'roommateWanted', 'roommatePreferences', 'roommatesWantedCount', 'currentOccupants',
          'roommatePrivateRoom', 'roommateFurnished', 'roommateSharedBathroom', 'roommateSharedKitchen',
          'roommateAuthorizationConfirmed'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 8
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 30
        && request.resource.data.description.size() <= 1500
        && request.resource.data.category in ['casa', 'departamento', 'cuarto', 'terreno', 'local', 'hotel', 'motel']
        && request.resource.data.operation in ['renta', 'venta', 'hospedaje']
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price <= 10000000
        && request.resource.data.colonia is string
        && request.resource.data.colonia.size() >= 2
        && request.resource.data.colonia.size() <= 80
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && validCloudinaryPhotos(request.resource.data)
        && request.resource.data.availability in ['available', 'occupied', 'reserved', 'rented', 'sold', 'unavailable', 'unconfirmed']
        && validHouseRules(request.resource.data)
        && validListingExtras(request.resource.data)
        && (!('roommateWanted' in request.resource.data) || request.resource.data.roommateWanted != true
          || request.resource.data.keys().hasAll([
            'roommatesWantedCount', 'currentOccupants', 'roommatePrivateRoom', 'roommateFurnished',
            'roommateSharedBathroom', 'roommateSharedKitchen', 'roommateAuthorizationConfirmed'
          ]) && request.resource.data.roommateAuthorizationConfirmed == true)
        && validNearbyInformation(request.resource.data)
        && (request.resource.data.category != 'hotel'
          || (request.resource.data.operation == 'hospedaje'
            && request.resource.data.priceUnit == 'noche'
            && request.resource.data.establishmentName is string
            && request.resource.data.establishmentName.size() >= 2
            && request.resource.data.roomType is string
            && request.resource.data.roomType.size() >= 2
            && request.resource.data.checkInTime is string
            && request.resource.data.checkOutTime is string))
        && (request.resource.data.category != 'motel'
          || (request.resource.data.operation == 'hospedaje'
            && request.resource.data.priceUnit in ['estancia', 'noche']
            && request.resource.data.establishmentName is string
            && request.resource.data.establishmentName.size() >= 2
            && request.resource.data.roomType is string
            && request.resource.data.roomType.size() >= 2
            && request.resource.data.checkInTime is string
            && request.resource.data.checkOutTime is string
            && (request.resource.data.priceUnit != 'estancia'
              || (request.resource.data.stayDurationHours is int
                && request.resource.data.stayDurationHours >= 1
                && request.resource.data.stayDurationHours <= 24))))
        && (!('foodAvailable' in request.resource.data)
          || request.resource.data.foodAvailable != true
          || (request.resource.data.foodDescription is string
            && request.resource.data.foodDescription.size() >= 3));

      allow update: if isAdmin()
        || (
          verified()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == resource.data.status
          && request.resource.data.category == resource.data.category
          && request.resource.data.operation == resource.data.operation
          && request.resource.data.price == resource.data.price
          && request.resource.data.colonia == resource.data.colonia
          && request.resource.data.lat == resource.data.lat
          && request.resource.data.lng == resource.data.lng
          && request.resource.data.ownerEmailVerified == true
          && request.resource.data.availability in [
            'available',
            'reserved',
            'rented',
            'sold',
            'unavailable',
            'unconfirmed'
          ]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'description',
            'bedrooms',
            'bathrooms',
            'parkingSpots',
            'areaM2',
            'amenities',
            'nearbyPlaces',
            'nearbyServices',
            'nearbyServicesOther',
            'safetyLevel',
            'safetyDetails',
            'waterIssueLevel',
            'waterIssueDetails',
            'transportAvailability',
            'transportDestinations',
            'maxGuests',
            'childrenAllowed',
            'petsAllowed',
            'smokingAllowed',
            'alcoholConsumptionAllowed',
            'alcoholSalesAllowed',
            'commercialActivityAllowed',
            'commercialActivityNotes',
            'shortStayUse',
            'shortStayNotes',
            'securityDepositMonths', 'guarantorRequired', 'proofIncomeRequired',
            'minimumLeaseMonths', 'rentalRequirementsNotes',
            'waterBilling', 'waterMonthlyCost', 'electricityBilling', 'electricityMonthlyCost',
            'internetBilling', 'internetMonthlyCost', 'stepFreeAccess', 'rampAccess',
            'accessibleBathroom', 'elevatorAccess', 'visitAvailability',
            'openHouseStartAt', 'openHouseEndAt', 'openHouseCapacity', 'openHouseNotes',
            'roommateWanted', 'roommatePreferences', 'roommatesWantedCount', 'currentOccupants',
            'roommatePrivateRoom', 'roommateFurnished', 'roommateSharedBathroom', 'roommateSharedKitchen',
            'photos',
            'photoPublicIds',
            'ownerEmailVerified',
            'availability',
            'availabilityConfirmedAt',
            'showPhone',
            'priceUnit',
            'updatedAt'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photos'])
            || validCloudinaryPhotos(request.resource.data))
          && validHouseRules(request.resource.data)
          && validListingExtras(request.resource.data)
          && validNearbyInformation(request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description'])
            || validListingText(request.resource.data))
        );

      // Hoteles y moteles pueden editar sus habitaciones y disponibilidad.
      allow update: if verified()
        && resource.data.ownerId == request.auth.uid
        && resource.data.category in ['hotel', 'motel']
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.category == resource.data.category
        && request.resource.data.operation == 'hospedaje'
        && request.resource.data.colonia == resource.data.colonia
        && request.resource.data.lat == resource.data.lat
        && request.resource.data.lng == resource.data.lng
        && request.resource.data.ownerEmailVerified == true
        && request.resource.data.price > 0
        && request.resource.data.establishmentName is string
        && request.resource.data.establishmentName.size() >= 2
        && request.resource.data.roomType is string
        && request.resource.data.roomType.size() >= 2
        && request.resource.data.checkInTime is string
        && request.resource.data.checkOutTime is string
        && validListingText(request.resource.data)
        && request.resource.data.price is number
        && request.resource.data.price <= 10000000
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description'])
          || validListingText(request.resource.data))
        && request.resource.data.availability in [
          'available', 'occupied', 'reserved', 'unavailable', 'unconfirmed'
        ]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'price', 'priceUnit',
          'bedrooms', 'bathrooms', 'parkingSpots', 'areaM2', 'amenities',
          'nearbyPlaces', 'nearbyServices', 'nearbyServicesOther',
          'safetyLevel', 'safetyDetails', 'waterIssueLevel', 'waterIssueDetails',
          'transportAvailability', 'transportDestinations',
          'maxGuests', 'childrenAllowed', 'petsAllowed', 'smokingAllowed',
          'alcoholConsumptionAllowed', 'alcoholSalesAllowed',
          'securityDepositMonths', 'guarantorRequired', 'proofIncomeRequired',
          'minimumLeaseMonths', 'rentalRequirementsNotes',
          'waterBilling', 'waterMonthlyCost', 'electricityBilling', 'electricityMonthlyCost',
          'internetBilling', 'internetMonthlyCost', 'stepFreeAccess', 'rampAccess',
          'accessibleBathroom', 'elevatorAccess', 'visitAvailability',
          'openHouseStartAt', 'openHouseEndAt', 'openHouseCapacity', 'openHouseNotes',
          'roommateWanted', 'roommatePreferences',
          'photos', 'photoPublicIds', 'ownerEmailVerified', 'availability',
          'availabilityConfirmedAt', 'showPhone', 'updatedAt',
          'establishmentName', 'roomType', 'stayDurationHours',
          'checkInTime', 'checkOutTime', 'reception24h',
          'foodAvailable', 'foodDescription'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photos'])
          || validCloudinaryPhotos(request.resource.data))
        && validHouseRules(request.resource.data)
        && validListingExtras(request.resource.data)
        && validNearbyInformation(request.resource.data)
        && (resource.data.category != 'hotel'
          || request.resource.data.priceUnit == 'noche')
        && (resource.data.category != 'motel'
          || request.resource.data.priceUnit in ['estancia', 'noche'])
        && (resource.data.category != 'motel'
          || request.resource.data.priceUnit != 'estancia'
          || (request.resource.data.stayDurationHours is int
            && request.resource.data.stayDurationHours >= 1
            && request.resource.data.stayDurationHours <= 24))
        && (!('foodAvailable' in request.resource.data)
          || request.resource.data.foodAvailable != true
          || (request.resource.data.foodDescription is string
            && request.resource.data.foodDescription.size() >= 3));

      allow update: if verified()
        && activePublishedListing(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoritesCount'])
        && request.resource.data.favoritesCount is int
        && request.resource.data.favoritesCount >= 0
        && (
          (request.resource.data.favoritesCount == resource.data.get('favoritesCount', 0) + 1
            && !exists(/databases/$(database)/documents/favorites/$(request.auth.uid + '_' + listingId))
            && existsAfter(/databases/$(database)/documents/favorites/$(request.auth.uid + '_' + listingId))
            && getAfter(/databases/$(database)/documents/favorites/$(request.auth.uid + '_' + listingId)).data.userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/favorites/$(request.auth.uid + '_' + listingId)).data.listingId == listingId)
          || (request.resource.data.favoritesCount == resource.data.get('favoritesCount', 0) - 1
            && resource.data.get('favoritesCount', 0) > 0
            && exists(/databases/$(database)/documents/favorites/$(request.auth.uid + '_' + listingId))
            && !existsAfter(/databases/$(database)/documents/favorites/$(request.auth.uid + '_' + listingId)))
        );

      allow update: if verified()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'expiresAt', 'updatedAt'
        ])
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis();

      // El propietario puede renovar un anuncio archivado y volver a publicarlo.
      allow update: if verified()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'archived'
        && resource.data.expiresAt is int
        && resource.data.expiresAt <= request.time.toMillis()
        && request.resource.data.status == 'published'
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'expiresAt', 'updatedAt'
        ]);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Dirección exacta: solo el propietario del anuncio y administradores.
    match /listingPrivateDetails/{listingId} {
      allow get: if isAdmin()
        || (verified()
          && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid);
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (verified()
          && request.resource.data.ownerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['ownerId', 'address', 'whatsapp', 'updatedAt'])
          && request.resource.data.keys().hasAll(['ownerId', 'updatedAt'])
          && (('address' in request.resource.data)
            || ('whatsapp' in request.resource.data))
        && (!('address' in request.resource.data)
          || (request.resource.data.address is string
              && request.resource.data.address.size() <= 200
              && !request.resource.data.address.matches('.*[<>].*')))
          && (!('whatsapp' in request.resource.data)
            || (request.resource.data.whatsapp is string
              && request.resource.data.whatsapp.matches('^[0-9]{10}$'))));

      allow update: if isAdmin()
        || (verified()
          && resource.data.ownerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'address', 'whatsapp', 'updatedAt'
          ])
          && (!('address' in request.resource.data)
            || (request.resource.data.address is string
              && request.resource.data.address.size() <= 200
              && !request.resource.data.address.matches('.*[<>].*')))
          && request.resource.data.whatsapp == resource.data.whatsapp);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /favorites/{favoriteId} {
      allow read: if verified()
        && resource.data.userId == request.auth.uid;

      allow create: if verified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.listingId is string
        && favoriteId == request.auth.uid + '_' + request.resource.data.listingId
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
        && activePublishedListing(get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data);

      allow delete: if verified()
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin()
        || (verified() && resource.data.reporterId == request.auth.uid);

      allow create: if false;

      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if verified()
        && resource.data.recipientId == request.auth.uid;

      allow create: if isAdmin();

      allow update: if verified()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead'
        ]);

      allow delete: if verified()
        && resource.data.recipientId == request.auth.uid;
    }

    match /messages/{messageId} {
      allow read: if verified()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
        );

      allow create: if false;

      allow update: if verified()
        && resource.data.recipientId == request.auth.uid
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'read')
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitStatus'])
            && resource.data.visitStatus in ['requested', 'confirmed']
            && request.resource.data.visitStatus in ['confirmed', 'cancelled'])
        );

      allow delete: if false;
    }

    match /listingHistory/{historyId} {
      allow read: if signedIn()
        && (
          resource.data.actorId == request.auth.uid
          || get(
            /databases/$(database)/documents/listings/$(resource.data.listingId)
          ).data.ownerId == request.auth.uid
          || isAdmin()
        );

      allow create: if isAdmin()
        || (verified() && request.resource.data.actorId == request.auth.uid);

      allow update, delete: if false;
    }

    // Campaign documents contain contact and commercial terms. Public delivery
    // and every write go through server endpoints that return a safe projection.
    match /businessAds/{adId} {
      allow read, write: if false;
    }

    match /businessAdControl/{controlId} {
      allow read, write: if false;
    }

    match /businessAdMetricLimits/{limitId} {
      allow read, write: if false;
    }
  }
}
